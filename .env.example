# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Worker URL for sandbox API
# For local development with wrangler: http://localhost:8787
# For deployed worker: https://your-worker.your-subdomain.workers.dev
SANDBOX_WORKER_URL=http://localhost:8787

# Agent server port (optional, default: 3000)
PORT=3000

SANDBOX_API_KEY=

R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com